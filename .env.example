# ====================================================================
# VENUS GREEN - ENVIRONMENT VARIABLES CONFIGURATION
# ====================================================================

# 1. SUPABASE DATABASE CONFIGURATION
# Obtain these from: https://supabase.com -> Your Project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 2. RAZORPAY PAYMENT GATEWAY (UPI, CARDS, NETBANKING)
# Obtain these from: https://dashboard.razorpay.com -> Settings -> API Keys
# Test keys start with "rzp_test_...", Live keys start with "rzp_live_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# 3. ADMIN PANEL ACCESS CREDENTIALS
# Login credentials for accessing https://yourdomain/admin
ADMIN_EMAIL=admin@venusgreen.com
ADMIN_PASSWORD=venusgreen@2026

# 4. APPLICATION URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
